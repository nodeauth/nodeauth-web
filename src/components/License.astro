---
// src/components/License.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="license" class="section-wrapper">
    <div class="section-subtitle">{t('price.subtitle')}</div>
    <h2 class="section-title">{t('price.title')}</h2>
    <p class="section-desc" set:html={t('price.desc')}></p>
    
    <div class="pricing-grid">
        <!-- 1. Monthly Plan -->
        <div class="pricing-card">
            <div class="card-header">
                <h3>{t('price.tier.monthly.name')}</h3>
                <p class="plan-desc">{t('price.tier.monthly.desc')}</p>
            </div>
            <div class="price-box">
                <div class="price">{t('price.tier.monthly.price')}</div>
                <div class="period">{t('price.tier.monthly.period')}</div>
            </div>
            <ul class="pricing-list">
                <li>{t('price.common.f1')}</li>
                <li>{t('price.common.f2')}</li>
                <li>{t('price.common.f3')}</li>
                <li>{t('price.common.f4')}</li>
            </ul>
            <a href="https://license.nextmatrix.app/?product=nodeauth&tier=pro_monthly" class="btn-card btn-outline">
                {t('price.tier.monthly.btn')}
            </a>
        </div>

        <!-- 2. Annual Plan -->
        <div class="pricing-card">
            <div class="card-header">
                <h3>{t('price.tier.annual.name')}</h3>
                <p class="plan-desc">{t('price.tier.annual.desc')}</p>
            </div>
            <div class="price-box">
                <div class="price">{t('price.tier.annual.price')}</div>
                <div class="period">{t('price.tier.annual.period')}</div>
            </div>
            <ul class="pricing-list">
                <li>{t('price.common.f1')}</li>
                <li>{t('price.common.f2')}</li>
                <li>{t('price.common.f3')}</li>
                <li>{t('price.common.f4')}</li>
            </ul>
            <a href="https://license.nextmatrix.app/?product=nodeauth&tier=pro_annual" class="btn-card btn-outline">
                {t('price.tier.annual.btn')}
            </a>
        </div>

        <!-- 3. Lifetime License (Featured / Most Popular) -->
        <div class="pricing-card featured-lifetime">
            <div class="badge badge-popular">{t('price.tier.lifetime.badge')}</div>
            <div class="card-header">
                <h3>{t('price.tier.lifetime.name')}</h3>
                <p class="plan-desc">{t('price.tier.lifetime.desc')}</p>
            </div>
            <div class="price-box">
                <div class="price">{t('price.tier.lifetime.price')}</div>
                <div class="period">{t('price.tier.lifetime.period')}</div>
            </div>
            <ul class="pricing-list">
                <li>{t('price.common.f1')}</li>
                <li>{t('price.common.f2')}</li>
                <li>{t('price.common.f3')}</li>
                <li>{t('price.common.f4')}</li>
            </ul>
            <a href="https://license.nextmatrix.app/?product=nodeauth&tier=pro_lifetime" class="btn-card btn-gradient">
                {t('price.tier.lifetime.btn')}
            </a>
        </div>
    </div>

    <!-- Supported payment gateways and help -->
    <div class="payment-footer">
        <div class="payment-icons">
            <span>Visa / Master</span>
            <span>WeChat Pay</span>
            <span>Alipay</span>
            <span>Crypto (USDT)</span>
        </div>
        <p class="help-text" set:html={t('price.help')}></p>
    </div>
</section>

<style>
.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1200px;
    margin: 3.5rem auto 0;
    align-items: stretch;
}

.pricing-card {
    background: linear-gradient(155deg, #18181b 0%, #09090b 100%);
    color: white;
    padding: clamp(1.8rem, 3vw, 2.8rem);
    border-radius: 28px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    box-sizing: border-box;
}

.pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.2);
}

/* Featured Hero Card: Lifetime $9.99 */
.pricing-card.featured-lifetime {
    background: linear-gradient(155deg, #1e1b4b 0%, #0f172a 100%);
    border: 1.5px solid rgba(99, 102, 241, 0.65);
    box-shadow: 0 25px 70px rgba(99, 102, 241, 0.28);
    transform: scale(1.02);
    z-index: 2;
}
.pricing-card.featured-lifetime:hover {
    border-color: rgba(129, 140, 248, 1);
    box-shadow: 0 35px 90px rgba(99, 102, 241, 0.45);
    transform: scale(1.04) translateY(-8px);
}

/* Badges */
.badge {
    position: absolute;
    top: -14px;
    right: 24px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
.badge-popular {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
}
.badge-gold {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #000000;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
}

.card-header h3 {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    font-weight: 600;
    margin: 0 0 0.4rem;
    color: #f4f4f5;
}
.plan-desc {
    font-size: 0.85rem;
    color: #a1a1aa;
    margin: 0;
    min-height: 2.2rem;
}

.price-box {
    margin: 1.5rem 0 1.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1.5rem;
}
.price {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1;
    color: #ffffff;
}
.period {
    font-size: 0.85rem;
    color: #a1a1aa;
    margin-top: 0.5rem;
    font-weight: 500;
}

.pricing-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    flex: 1;
}
.pricing-list li {
    font-size: 0.9rem;
    color: #d4d4d8;
    margin-bottom: 0.9rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.45;
}
.pricing-list li::before {
    content: '✓';
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 0.1rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    font-size: 0.8rem;
    color: #fff;
}

/* Button styles */
.btn-card {
    display: block;
    text-align: center;
    padding: 0.95rem 1.2rem;
    font-size: 0.95rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-top: auto;
}
.btn-outline {
    background: rgba(255, 255, 255, 0.05);
    color: #f4f4f5;
    border: 1px solid rgba(255, 255, 255, 0.15);
}
.btn-outline:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.02);
}

.btn-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
}
.btn-gradient:hover {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    box-shadow: 0 6px 25px rgba(99, 102, 241, 0.55);
    transform: scale(1.02);
}

.btn-white {
    background: #ffffff;
    color: #09090b;
}
.btn-white:hover {
    background: #f4f4f5;
    box-shadow: 0 6px 25px rgba(255, 255, 255, 0.25);
    transform: scale(1.02);
}

.payment-footer {
    margin-top: 3rem;
    text-align: center;
}
.payment-icons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    opacity: 0.55;
    font-size: 0.95rem;
    font-weight: 500;
}
.help-text {
    margin-top: 1.2rem;
    font-size: 0.9rem;
    color: #71717a;
}

@media (max-width: 960px) {
    .pricing-grid {
        grid-template-columns: 1fr;
        max-width: 500px;
        gap: 2rem;
    }
    .badge {
        top: -12px;
        right: 20px;
    }
}
</style>
