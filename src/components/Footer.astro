---
// src/components/Footer.astro
// NodeAuth 官网底栏（链接产品生态与 NextMatrix LLC 公司及法务页）
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homePath = lang === 'cn' ? '/cn/' : '/';
const companyBase = 'https://nextmatrix.app';
const prefix = lang === 'cn' ? '/cn' : '';
const aboutPath = `${companyBase}${prefix}/about/`;
const brandPath = `${companyBase}${prefix}/brand/`;
const contactPath = `${companyBase}${prefix}/contact/`;
const termsPath = `${companyBase}/terms/`;
const privacyPath = `${companyBase}/privacy/`;
const refundPath = `${companyBase}/refund/`;
const wikiUrl = lang === 'cn' ? 'https://wiki.nodeauth.io/cn/' : 'https://wiki.nodeauth.io/';
---

<footer class="site-footer">
    <div class="footer-inner">
        <!-- 顶部 4 栏主体 -->
        <div class="footer-top">
            <!-- 1. 品牌与定位 -->
            <div class="footer-brand">
                <a href={homePath} class="brand-logo" aria-label="NodeAuth home">
                    <img src="/logo.svg" alt="NodeAuth Logo" width="28" height="28" />
                    <span>NodeAuth</span>
                </a>
                <p class="footer-bio">{t('hero.desc')}</p>
            </div>

            <!-- 2. NodeAuth 生态 -->
            <div class="footer-col">
                <span class="col-title">{lang === 'cn' ? 'NODEAUTH 生态' : 'ECOSYSTEM'}</span>
                <ul class="col-links">
                    <li><a href={wikiUrl} target="_blank" rel="noopener noreferrer" class="link-item">{lang === 'cn' ? '官方文档 Wiki' : 'Official Wiki'}</a></li>
                    <li><a href="https://demo.nodeauth.io" target="_blank" rel="noopener noreferrer" class="link-item">{lang === 'cn' ? '在线体验 Demo' : 'Live Web Demo'}</a></li>
                    <li><a href="https://tools.nodeauth.io" target="_blank" rel="noopener noreferrer" class="link-item">{lang === 'cn' ? 'BYOS 部署工具' : 'BYOS Tools'}</a></li>
                    <li><a href="https://license.nextmatrix.app" target="_blank" rel="noopener noreferrer" class="link-item">{lang === 'cn' ? 'Pro 授权中心' : 'License Center'}</a></li>
                </ul>
            </div>

            <!-- 3. 公司与法务 -->
            <div class="footer-col">
                <span class="col-title">{t('footer.col_company')}</span>
                <ul class="col-links">
                    <li><a href={aboutPath} class="link-item">{t('footer.comp_about')}</a></li>
                    <li><a href={contactPath} class="link-item">{t('footer.comp_contact')}</a></li>
                    <li><a href={brandPath} class="link-item">{t('footer.comp_brand')}</a></li>
                    <li><a href={termsPath} class="link-item">{t('footer.comp_terms')}</a></li>
                    <li><a href={privacyPath} class="link-item">{t('footer.comp_privacy')}</a></li>
                    <li><a href={refundPath} class="link-item">{t('footer.comp_refund')}</a></li>
                </ul>
            </div>

            <!-- 4. 法人实体与联系 -->
            <div class="footer-col footer-contact">
                <span class="col-title">{t('footer.col_contact')}</span>
                <address class="contact-details">
                    <strong class="entity-name">{t('footer.contact_entity')}</strong>
                    <a href={`mailto:${t('footer.contact_email')}`} class="contact-link">{t('footer.contact_email')}</a>
                    <a href={`tel:${t('footer.contact_phone').replace(/[^+\d]/g, '')}`} class="contact-link">{t('footer.contact_phone')}</a>
                    <div class="contact-address">
                        <span>{t('footer.contact_addr1')}</span>
                        <span>{t('footer.contact_addr2')}</span>
                        <span>{t('footer.contact_country')}</span>
                    </div>
                </address>
            </div>
        </div>

        <!-- 底部版权与返回顶部 -->
        <div class="footer-bottom">
            <span class="copyright" set:html={t('footer.rights')}></span>
            <a href="#top" class="back-to-top" id="backToTopBtn">{t('footer.back_to_top')}</a>
        </div>
    </div>
</footer>

<script>
    // 平滑返回顶部
    document.addEventListener('DOMContentLoaded', () => {
        const backToTopBtn = document.getElementById('backToTopBtn');
        if (backToTopBtn) {
            backToTopBtn.addEventListener('click', (e) => {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    });
</script>

<style>
.site-footer {
    position: relative;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem) 2.5rem;
    background-color: var(--bg-color, #fafafa);
    color: var(--text-secondary, #71717a);
    font-size: 0.92rem;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
    margin-top: auto;
}

:global([data-theme='dark']) .site-footer {
    background-color: rgba(18, 18, 20, 0.95);
    border-top-color: rgba(255, 255, 255, 0.08);
}

.footer-inner {
    max-width: 1280px;
    margin: 0 auto;
}

.footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: clamp(2rem, 4vw, 4rem);
    text-align: left;
    margin-bottom: clamp(3rem, 5vw, 4rem);
}

/* 1. 品牌列 */
.footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-right: 1.5rem;
}

.brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--text-primary, #09090b);
    text-decoration: none;
    letter-spacing: -0.4px;
}

.brand-logo img {
    display: inline-block;
    width: 28px;
    height: auto;
    aspect-ratio: 900 / 692;
}

.footer-bio {
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--text-secondary, #71717a);
    margin: 0;
    max-width: 320px;
}

/* 列标题 */
.col-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary, #71717a);
    opacity: 0.75;
    margin-bottom: 1.25rem;
}

/* 链接列表 */
.col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.link-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-primary, #18181b);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease, transform 0.2s ease;
    opacity: 0.85;
}

.link-item:hover {
    color: var(--accent, #3b82f6);
    opacity: 1;
    transform: translateX(2px);
}

.link-item .arrow {
    opacity: 0.45;
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.link-item:hover .arrow {
    opacity: 1;
    transform: translate(1px, -1px);
}

.link-item.item-disabled {
    cursor: default;
    opacity: 0.65;
    user-select: none;
}
.link-item.item-disabled:hover {
    color: inherit;
    transform: none;
}

.badge-sub {
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: var(--text-secondary);
}

:global([data-theme='dark']) .badge-sub {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
}

/* 4. 联系实体列 */
.contact-details {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.5;
}

.entity-name {
    color: var(--text-primary, #09090b);
    font-size: 0.95rem;
    font-weight: 700;
}

.contact-link {
    color: var(--text-primary, #18181b);
    text-decoration: none;
    opacity: 0.85;
    transition: color 0.2s ease;
}

.contact-link:hover {
    color: var(--accent, #3b82f6);
    opacity: 1;
}

.contact-address {
    font-size: 0.88rem;
    color: var(--text-secondary, #71717a);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.35rem;
    line-height: 1.45;
}

/* 底栏版权与 Back to top */
.footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
    font-size: 0.84rem;
    color: var(--text-secondary, #71717a);
}

:global([data-theme='dark']) .footer-bottom {
    border-top-color: rgba(255, 255, 255, 0.08);
}

.back-to-top {
    color: var(--text-secondary, #71717a);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
}

.back-to-top:hover {
    color: var(--text-primary, #09090b);
    transform: translateY(-2px);
}

@media (max-width: 1024px) {
    .footer-top {
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
    }
}

@media (max-width: 640px) {
    .footer-top {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    .footer-bottom {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }
}
</style>
