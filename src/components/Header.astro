---
// src/components/Header.astro
// NodeAuth 独立产品官网顶部导航栏
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homePath = lang === 'cn' ? '/cn/' : '/';
const enPath = '/';
const cnPath = '/cn/';

const githubUrl = 'https://github.com/nextmatrixllc/nodeauth';
---

<nav class="site-header">
    <div class="nav-content">
        <!-- Logo -->
        <a href={homePath} class="logo" aria-label="NodeAuth Home">
            <img src="/logo.svg" alt="NodeAuth Logo" width="26" height="26" />
            <span>NodeAuth</span>
        </a>

        <!-- 主导航 -->
        <div class="links" id="primaryNavLinks">
            <a href="#mobile-app" class="nav-link">{t('hero.app')}</a>
            <a href="#extension" class="nav-link">{t('hero.extension')}</a>
            <a href="#self-host" class="nav-link">{t('hero.byos')}</a>
            <a href="#license" class="nav-link">{t('hero.buy')}</a>

            <!-- 移动端底部快捷操作 -->
            <div class="mobile-actions">
                <button class="theme-toggle-btn" aria-label="Toggle Theme">
                    <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="4.22" x2="19.78" y2="5.64"></line></svg>
                    <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
                <a href={githubUrl} class="github-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
                    </svg>
                </a>
            </div>
        </div>

        <!-- 右侧功能区（语言选择、深色模式切换、GitHub、移动端汉堡按钮） -->
        <div class="nav-right">
            <!-- 语言切换 -->
            <div class="lang-selector">
                <button aria-label="Select Language">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m5 8 6 6" />
                        <path d="m4 14 6-6 2-3" />
                        <path d="M2 5h12" />
                        <path d="M7 2h1" />
                        <path d="m22 22-5-10-5 10" />
                        <path d="M14 18h6" />
                    </svg>
                    <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
                <div class="lang-dropdown">
                    <a href={enPath} class={lang === 'en' ? 'active' : ''}>English</a>
                    <a href={cnPath} class={lang === 'cn' ? 'active' : ''}>简体中文</a>
                </div>
            </div>

            <div class="divider desktop-only"></div>

            <!-- 主题切换 -->
            <button class="theme-toggle-btn desktop-only" aria-label="Toggle Theme">
                <svg class="sun-icon" viewBox="0 0 24 24" width="19" height="19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="4.22" x2="19.78" y2="5.64"></line></svg>
                <svg class="moon-icon" viewBox="0 0 24 24" width="19" height="19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>

            <div class="divider desktop-only"></div>

            <!-- GitHub 链接 -->
            <a href={githubUrl} class="github-link desktop-only" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
                </svg>
            </a>

            <!-- 移动端汉堡切换按钮 -->
            <button class="menu-toggle" aria-label="Toggle Menu" id="navMenuToggle">
                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 移动端汉堡菜单切换
        const menuToggle = document.getElementById('navMenuToggle');
        const primaryNav = document.getElementById('primaryNavLinks');
        if (menuToggle && primaryNav) {
            menuToggle.addEventListener('click', () => {
                primaryNav.classList.toggle('active');
            });
        }

        // 移动端手风琴折叠展开支持
        const dropdownWrappers = document.querySelectorAll('.nav-dropdown-wrapper');
        dropdownWrappers.forEach(wrapper => {
            const trigger = wrapper.querySelector('.nav-dropdown-trigger');
            if (trigger) {
                trigger.addEventListener('click', (e) => {
                    if (window.innerWidth <= 1024) {
                        e.preventDefault();
                        const isOpen = wrapper.classList.contains('mobile-expanded');
                        // 互斥关闭其他展开的子菜单
                        dropdownWrappers.forEach(w => w.classList.remove('mobile-expanded'));
                        if (!isOpen) {
                            wrapper.classList.add('mobile-expanded');
                        }
                    }
                });
            }
        });

        // 主题切换
        const themeToggles = document.querySelectorAll('.theme-toggle-btn');
        themeToggles.forEach(btn => {
            btn.addEventListener('click', () => {
                const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
            });
        });
    });
</script>

<style>
.site-header {
    position: fixed;
    top: 0;
    width: 100%;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    transition: all 0.3s ease;
}

.nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    padding: clamp(0.75rem, 1.8vw, 0.95rem) clamp(1rem, 5vw, 2rem);
    box-sizing: border-box;
}

.logo {
    font-weight: 700;
    font-size: clamp(1.15rem, 3vw, 1.35rem);
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text-primary);
}

.logo img {
    display: inline-block;
    width: 28px;
    height: auto;
    aspect-ratio: 900 / 692;
}

/* 导航链接与下拉包裹器 */
.links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
}

.nav-dropdown-wrapper {
    position: relative;
    padding: 0.5rem 0;
}

/* 延长下边缘以消除与浮层之间的鼠标空隙 */
.nav-dropdown-wrapper::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 12px;
}

.nav-dropdown-trigger {
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    opacity: 0.78;
    transition: opacity 0.2s ease, color 0.2s ease;
}

.nav-dropdown-trigger:hover,
.nav-dropdown-wrapper:hover .nav-dropdown-trigger {
    opacity: 1;
    color: var(--text-primary);
}

.nav-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    opacity: 0.78;
    transition: opacity 0.2s ease, color 0.2s ease;
}

.nav-link:hover {
    opacity: 1;
    color: var(--text-primary);
}

/* 导航项激活态（方案 B：极简纯文字高亮） */
.nav-link.active,
.nav-dropdown-trigger.active {
    color: var(--accent, #3451B2);
    font-weight: 600;
    opacity: 1;
}

:global([data-theme='dark']) .nav-link.active,
:global([data-theme='dark']) .nav-dropdown-trigger.active {
    color: var(--accent, #3b82f6);
}

.nav-dropdown-trigger.active .nav-chevron {
    color: var(--accent, #3451B2);
    opacity: 1;
}

:global([data-theme='dark']) .nav-dropdown-trigger.active .nav-chevron {
    color: var(--accent, #3b82f6);
}

.dropdown-item.active .item-title {
    color: var(--accent, #3451B2);
    font-weight: 600;
}

:global([data-theme='dark']) .dropdown-item.active .item-title {
    color: var(--accent, #3b82f6);
}

.nav-link .ext-arrow {
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.nav-link:hover .ext-arrow {
    opacity: 1;
    transform: translate(1px, -1px);
}

.nav-chevron {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.6;
}

.nav-dropdown-wrapper:hover .nav-chevron {
    transform: rotate(180deg);
    opacity: 1;
}

/* Mega Dropdown 卡片通用样式（对标 NodeLoc 高质感设计） */
.mega-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: var(--nav-menu-bg, #ffffff);
    backdrop-filter: saturate(180%) blur(24px);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    border: 1px solid var(--border, rgba(0, 0, 0, 0.08));
    border-radius: 1.25rem;
    min-width: 330px;
    max-width: 380px;
    width: max-content;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.02);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 120;
    overflow: hidden;
}

:global([data-theme='dark']) .mega-dropdown {
    background: rgba(24, 24, 27, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 4px 16px rgba(0, 0, 0, 0.3);
}

.nav-dropdown-wrapper:hover .mega-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
}

/* 顶标 (Overline) */
.dropdown-header {
    padding: 1.1rem 1.25rem 0.45rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-tertiary, #a1a1aa);
    text-transform: uppercase;
}

/* 条目列表 */
.dropdown-items {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0.4rem 0.5rem;
}

.dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0.65rem 0.95rem;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: background 0.15s ease, transform 0.15s ease;
}

.dropdown-item:hover {
    background: rgba(128, 128, 128, 0.07);
    transform: translateX(2px);
}

:global([data-theme='dark']) .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
}

.dropdown-item.item-disabled {
    cursor: default;
    opacity: 0.65;
    user-select: none;
}

.dropdown-item.item-disabled:hover {
    background: none;
    transform: none;
}

.item-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.item-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
}

.item-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.42;
}

.ext-icon {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 400;
}

/* 状态徽章 */
.item-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 999px;
    line-height: 1.4;
    letter-spacing: 0.3px;
}

.tag-blue { background: rgba(59, 130, 246, 0.12); color: #2563eb; }
.tag-amber { background: rgba(245, 158, 11, 0.12); color: #d97706; }
.tag-emerald { background: rgba(16, 185, 129, 0.12); color: #059669; }
.tag-purple { background: rgba(168, 85, 247, 0.12); color: #9333ea; }

:global([data-theme='dark']) .tag-blue { color: #60a5fa; }
:global([data-theme='dark']) .tag-amber { color: #fbbf24; }
:global([data-theme='dark']) .tag-emerald { color: #34d399; }
:global([data-theme='dark']) .tag-purple { color: #c084fc; }

/* 底部行动条 */
.dropdown-footer {
    margin-top: 0.35rem;
    padding: 0.75rem 1.25rem;
    background: rgba(0, 0, 0, 0.02);
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.06));
}

:global([data-theme='dark']) .dropdown-footer {
    background: rgba(255, 255, 255, 0.02);
}

.footer-action-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent, #3b82f6);
    text-decoration: none;
    transition: gap 0.2s ease;
}

.footer-action-link:hover svg {
    transform: translateX(3px);
}

.footer-action-link svg {
    transition: transform 0.2s ease;
}

/* 右侧工具区 */
.nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.divider {
    width: 1px;
    height: 16px;
    background: var(--border);
    margin: 0 0.2rem;
}

.lang-selector {
    position: relative;
}

.lang-selector > button {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.75;
    transition: opacity 0.2s;
}

.lang-selector > button:hover {
    opacity: 1;
}

.lang-dropdown {
    position: absolute;
    top: 100%;
    right: 50%;
    transform: translateX(50%);
    background: var(--nav-menu-bg, #ffffff);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 120px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
    margin-top: 0.5rem;
    z-index: 130;
}

:global([data-theme='dark']) .lang-dropdown {
    background: rgba(24, 24, 27, 0.95);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.4);
}

.lang-selector:hover .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(50%) translateY(0);
}

.lang-dropdown a {
    padding: 0.5rem 1rem;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.88rem;
    border-radius: 6px;
    transition: background 0.2s;
}

.lang-dropdown a:hover {
    background: rgba(128, 128, 128, 0.1);
}

.lang-dropdown a.active {
    font-weight: 600;
    color: var(--accent, #3b82f6);
    background: rgba(59, 130, 246, 0.08);
}

.github-link {
    color: var(--text-primary);
    opacity: 0.75;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    padding: 0.5rem;
}

.github-link:hover {
    opacity: 1;
}

.theme-toggle-btn {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
    transition: opacity 0.2s;
    border-radius: 50%;
}

.theme-toggle-btn:hover {
    opacity: 1;
    background: rgba(128, 128, 128, 0.1);
}

:global(html[data-theme='dark']) .moon-icon { display: none; }
:global(html[data-theme='light']) .sun-icon { display: none; }
:global(html:not([data-theme])) .sun-icon { display: none; }

.menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    margin-right: -0.5rem;
}

.mobile-actions {
    display: none;
}

/* 响应式断点（<= 1024px） */
@media (max-width: 1024px) {
    .menu-toggle {
        display: block;
    }
    
    .desktop-only {
        display: none !important;
    }

    .links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        max-height: calc(100vh - 70px);
        overflow-y: auto;
        background: var(--nav-menu-bg, #ffffff);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        flex-direction: column;
        align-items: stretch;
        padding: 1.5rem 1.25rem 2.5rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        border-bottom: 1px solid var(--border);
        gap: 0.75rem;
    }

    :global([data-theme='dark']) .links {
        background: rgba(18, 18, 20, 0.98);
    }

    .links.active {
        display: flex;
    }

    .nav-dropdown-wrapper {
        padding: 0;
        width: 100%;
    }

    .nav-dropdown-trigger {
        width: 100%;
        justify-content: space-between;
        font-size: 1.05rem;
        font-weight: 600;
        padding: 0.75rem 0.5rem;
        border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.05));
    }

    .nav-link {
        width: 100%;
        justify-content: space-between;
        font-size: 1.05rem;
        font-weight: 600;
        padding: 0.75rem 0.5rem;
        border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.05));
        box-sizing: border-box;
    }

    /* 移动端手风琴展开逻辑 */
    .mega-dropdown {
        position: static;
        transform: none;
        box-shadow: none;
        border: none;
