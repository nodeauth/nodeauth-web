---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = getLangFromUrl(Astro.url);
const htmlLang = lang === 'cn' ? 'zh-CN' : 'en';
const t = useTranslations(lang);

const {
  title = t('site.title'),
  description = t('site.desc'),
  image = '/og-image.png',
} = Astro.props;

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://nodeauth.io').replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;
const basePath = normalizedPath === '/cn/' ? '/' : normalizedPath.replace(/^\/cn\//, '/');
const enAlternateUrl = `${siteUrl}${basePath}`;
const cnAlternateUrl = `${siteUrl}${basePath === '/' ? '/cn/' : `/cn${basePath}`}`;
const ogImageUrl = new URL(image, `${siteUrl}/`).toString();
const isHome = normalizedPath === '/' || normalizedPath === '/cn/';

const officialSameAs = [
  'https://github.com/nextmatrixllc/nodeauth',
  'https://github.com/nodeauth/nodeauth-worker',
  'https://apps.apple.com/app/id6820337516',
  'https://play.google.com/store/apps/details?id=com.nextmatrix.nodeauth',
  'https://chromewebstore.google.com/detail/nodeauth/ejknfokfdojopelcbidgchnopeapnjgd',
  'https://microsoftedge.microsoft.com/addons/detail/nodeauth/bclpbakllopgjhelikbhccpjkgbmfpgd',
  'https://addons.mozilla.org/en-US/firefox/addon/nodeauth/',
];

const faqItems = isHome
  ? [1, 2, 3, 4, 5, 6].map((idx) => ({
      '@type': 'Question',
      name: t(`faq.q${idx}` as any),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(`faq.a${idx}` as any),
      },
    }))
  : [];

const structuredData = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}${lang === 'cn' ? '/cn/#website' : '/#website'}`,
          name: 'NodeAuth',
          alternateName: ['NodeAuth 2FA', 'NodeAuth Authenticator'],
          url: canonicalUrl,
          inLanguage: htmlLang,
          publisher: { '@id': 'https://nextmatrix.app/#organization' },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': 'https://nodeauth.io/#software',
          name: 'NodeAuth',
          applicationCategory: 'SecurityApplication',
          operatingSystem: 'iOS, Android, Chrome, Edge, Firefox, Web',
          inLanguage: htmlLang,
          description,
          url: canonicalUrl,
          downloadUrl: 'https://apps.apple.com/app/id6820337516',
          image: ogImageUrl,
          screenshot: ogImageUrl,
          softwareHelp: {
            '@type': 'WebSite',
            url: lang === 'cn' ? 'https://wiki.nodeauth.io/cn/' : 'https://wiki.nodeauth.io/',
          },
          sameAs: officialSameAs,
          offers: [
            {
              '@type': 'Offer',
              name: lang === 'cn' ? '免费本地版 (Mobile App)' : 'Free Local Mobile App',
              price: '0',
              priceCurrency: 'USD',
              url: canonicalUrl,
            },
            {
              '@type': 'Offer',
              name: t('price.tier.monthly.name'),
              price: '1.99',
              priceCurrency: 'USD',
              url: 'https://license.nextmatrix.app/?product=nodeauth&tier=pro_monthly',
            },
            {
              '@type': 'Offer',
              name: t('price.tier.annual.name'),
              price: '5.99',
              priceCurrency: 'USD',
              url: 'https://license.nextmatrix.app/?product=nodeauth&tier=pro_annual',
            },
            {
              '@type': 'Offer',
              name: t('price.tier.lifetime.name'),
              price: '9.99',
              priceCurrency: 'USD',
              url: 'https://license.nextmatrix.app/?product=nodeauth&tier=pro_lifetime',
            },
          ],
          publisher: {
            '@type': 'Organization',
            '@id': 'https://nextmatrix.app/#organization',
            name: 'NextMatrix LLC',
            url: 'https://nextmatrix.app/',
          },
        },
        {
          '@type': 'FAQPage',
          '@id': `${canonicalUrl}#faq`,
          inLanguage: htmlLang,
          mainEntity: faqItems,
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />

    <title>{title}</title>

    <!-- SEO: Canonical & Hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enAlternateUrl} />
    <link rel="alternate" hreflang="zh-CN" href={cnAlternateUrl} />
    <link rel="alternate" hreflang="x-default" href={enAlternateUrl} />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function() {
        try {
          var storedTheme = localStorage.getItem('theme');
          var systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          var theme = storedTheme || systemTheme;
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NodeAuth" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
